    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH user_info AS (\n  SELECT id AS user_id, stripe_customer_id\n  FROM public.users\n  WHERE id = $1\n)\n\n, customer AS (\n  SELECT 'customer' AS entity, to_jsonb(c) AS data\n  FROM stripe.customers c\n  JOIN user_info u ON c.id = u.stripe_customer_id\n)\n\n, subscriptions AS (\n  SELECT 'subscription' AS entity, to_jsonb(s) AS data\n  FROM stripe.subscriptions s\n  JOIN user_info u ON s.customer = u.stripe_customer_id\n)\n\n, subscription_items AS (\n  SELECT 'subscription_item' AS entity, to_jsonb(si) AS data\n  FROM stripe.subscription_items si\n  JOIN stripe.subscriptions s ON si.subscription = s.id\n  JOIN user_info u ON s.customer = u.stripe_customer_id\n)\n\n, invoices AS (\n  SELECT 'invoice' AS entity, to_jsonb(i) AS data\n  FROM stripe.invoices i\n  JOIN user_info u ON i.customer = u.stripe_customer_id\n)\n\n, payment_intents AS (\n  SELECT 'payment_intent' AS entity, to_jsonb(pi) AS data\n  FROM stripe.payment_intents pi\n  JOIN user_info u ON pi.customer = u.stripe_customer_id\n)\n\n, payment_methods AS (\n  SELECT 'payment_method' AS entity, to_jsonb(pm) AS data\n  FROM stripe.payment_methods pm\n  JOIN user_info u ON pm.customer = u.stripe_customer_id\n)\n\n, charges AS (\n  SELECT 'charge' AS entity, to_jsonb(ch) AS data\n  FROM stripe.charges ch\n  JOIN user_info u ON ch.customer = u.stripe_customer_id\n)\n\n, refunds AS (\n  SELECT 'refund' AS entity, to_jsonb(r) AS data\n  FROM stripe.refunds r\n  JOIN user_info u ON r.charge IS NOT NULL\n  AND EXISTS (\n    SELECT 1 FROM stripe.charges ch WHERE ch.id = r.charge AND ch.customer = u.stripe_customer_id\n  )\n)\n\nSELECT\n  entity,\n  (data - 'id') || jsonb_build_object('id', data ->> 'id') AS data\nFROM (\n  SELECT * FROM customer\n  UNION ALL\n  SELECT * FROM subscriptions\n  UNION ALL\n  SELECT * FROM subscription_items\n  UNION ALL\n  SELECT * FROM invoices\n  UNION ALL\n  SELECT * FROM payment_intents\n  UNION ALL\n  SELECT * FROM payment_methods\n  UNION ALL\n  SELECT * FROM charges\n  UNION ALL\n  SELECT * FROM refunds\n) AS t;",
        "options": {
          "queryReplacement": "={{ $('When Executed by Another Workflow').item.user_id }}"
        }
      },
