    {
      "parameters": {
        "fields": {
          "values": [
            {
              "name": "nonce",
              "stringValue": "={{ $('When Executed by Another Workflow').item.json.message.text.match(/link\\s+([0-9a-fA-F-]+)/)[1] }}"
