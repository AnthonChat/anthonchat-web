    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f296d871-213c-49a7-870b-9f0c7a984a70",
              "name": "=message",
              "value": "={{\n(() => {\n  const base = $json.response;\n  // --- converter sicuro -> Telegram Markdown V2 ---\n  const RE_CODE      = /```[\\s\\S]*?```|`[^`]*?`/g;\n  const RE_BOLD      = /\\*\\*([\\s\\S]+?)\\*\\*|__([\\s\\S]+?)__/g;\n  const RE_ITAL_STAR = /(^|[^*])\\*([^\\n*]+?)\\*(?!\\*)/g;\n  const RE_ITAL_UND  = /(^|[^_])_([^\\n_]+?)_(?!_)/g;\n  const RE_STRK      = /~([^~]+?)~/g;\n  const RE_RSRV      = /[_*\\[\\]()~`>#+\\-=|{}.!\\\\]/g;\n  const PLACE = (i) => `\\u0000${i}\\u0000`;\n  const esc   = (s) => String(s).replace(RE_RSRV, '\\\\$&');\n  const safe  = (x) => (x == null ? '' : String(x));\n  const stash = (txt, re, fn, bag) =>\n    txt.replace(re, function () {\n      const seg = fn.apply(null, arguments);\n      const val = seg == null ? esc(arguments[0]) : String(seg);\n      bag.push(val);\n      return PLACE(bag.length - 1);\n    });\n\n  let out = String(base);\n  const bag = [];\n\n  out = stash(out, RE_CODE, (m) => m, bag);\n  out = stash(out, RE_BOLD, (_m, g1, g2) => {\n    const txt = safe(g1 ?? g2).trim();\n    return txt ? `*${esc(txt)}*` : esc(_m);\n  }, bag);\n  out = stash(out, RE_ITAL_STAR, (_m, pre, g) => {\n    const txt = safe(g).trim();\n    return txt ? `${safe(pre)}_${esc(txt)}_` : esc(_m);\n  }, bag);\n  out = stash(out, RE_ITAL_UND, (_m, pre, g) => {\n    const txt = safe(g).trim();\n    return txt ? `${safe(pre)}_${esc(txt)}_` : esc(_m);\n  }, bag);\n  out = stash(out, RE_STRK, (_m, g) => {\n    const txt = safe(g).trim();\n    return txt ? `~${esc(txt)}~` : esc(_m);\n  }, bag);\n\n  out = esc(out).replace(/(^|\\n)-/g, '$1\\\\-');\n  out = out.replace(/\\u0000(\\d+)\\u0000/g, (_m, i) => safe(bag[Number(i)]));\n  out = out.replace(/(^|[^\\\\])__($|[^_])/g, (_m, a, b) => `${a}\\\\_\\\\_${b}`);\n\n  // ultima rete di sicurezza: rimuovi \"undefined\" letterali residui (solo se proprio serve)\n  out = out.replace(/undefined/g, '');\n\n  return out;\n})()\n}}\n",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
